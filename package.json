{
  "name": "autobroll",
  "version": "0.3.0",
  "description": "AI short-form video editor in the browser: auto-arrange takes, cut silence, human-looking captions, auto B-roll, keyframed zoom/pan — built on Remotion.",
  "license": "MIT",
  "private": true,
  "keywords": [
    "remotion",
    "captions",
    "subtitles",
    "video",
    "whisper",
    "b-roll",
    "short-form",
    "video-editing"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "setup": "bash scripts/setup.sh",
    "editor": "vite",
    "editor:server": "node server/index.mjs",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.380",
    "@remotion/install-whisper-cpp": "^4.0.380",
    "@remotion/media-parser": "^4.0.380",
    "@remotion/player": "^4.0.380",
    "@remotion/studio": "^4.0.380",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.380",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.2",
    "vite": "^5.4.21"
  }
}
