# Gemini — accent detection, B-roll planning, clip arranging.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels — stock footage/photo search for Auto B-roll.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: domain words to bias transcription accuracy for YOUR videos,
# e.g. product names, brands, topics you talk about.
# AUTOBROLL_PROMPT=The following is a talking-head video about <your topic>. Proper nouns and brands are capitalized.

# Optional: force the WhisperX device (default: auto — cuda if torch sees a GPU, else cpu).
# AUTOBROLL_DEVICE=cpu
